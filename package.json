{
  "name": "jaderka-rozvrh",
  "version": "0.1.0",
  "description": "Lightweight editor for FJFI (Jaderka) student timetables",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "update-names": "node scripts/update-known-names.mjs",
    "fetch-fjfi": "node scripts/fetch-fjfi.mjs",
    "check-programs": "node scripts/fetch-fjfi.mjs --check-programs"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "jsdom": "^29.1.1",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "private": true,
  "dependencies": {
    "pdfjs-dist": "^6.5.438",
    "tesseract.js": "^7.0.0"
  }
}
